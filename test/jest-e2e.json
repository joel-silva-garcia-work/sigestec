{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../src",
  "coverageDirectory": "coverage",
  "collectCoverage": true,
  "coverageReporters": ["html", "text", "lcov"],
  "coverageThreshold": {
    "global": {
      "lines": 70
    }
  },
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
